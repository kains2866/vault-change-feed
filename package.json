{
  "name": "vault-change-feed",
  "version": "2.0.0",
  "description": "Logs your manual vault edits as a lightweight machine-readable feed, so AI assistants can catch up incrementally instead of rescanning — less context waste when managing your notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "changelog"
  ],
  "author": "tiyukains",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
